diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_color_grading.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_color_grading.frag
new file mode 100644
index 0000000..81b2950
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_color_grading.frag
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Native+ (the 16-bit chain): replaces the game's ColorGrading pass (ed4c7668), a 16x16x16
+// color table applied to the image. The table only covers BT.709 0..1: up to white it is applied
+// exactly as the game does; above white the color is divided by its largest channel, graded and
+// scaled back; a color outside BT.709 goes through RenoDX's SDR LUT bridge
+// (.agents/skills/handle-sdr-tonemap-lut/snippets/sdr_lut_bridge.hlsl): brought inside it
+// (AdaptiveD65 gamut compression, gamut_bridge.glsl), its largest channel into the table's range,
+// graded, then both taken back out, so the HDR part keeps its hue and saturation and is graded
+// too. The strength of the grading (the in-game menu's Color Grade Strength, 0 none .. 1 the
+// game's) comes in bb_hdr.w, set for this draw only. The names are the recompiled shader's:
+// vk_hdr_channel.cpp copies its bindings and locations onto these.
+
+#version 450
+#ifndef BB_HW_INTERP
+#extension GL_EXT_fragment_shader_barycentric : require
+#endif
+#extension GL_GOOGLE_include_directive : require
+
+#include "bb_inputs.glsl"
+#include "gamut_bridge.glsl"
+
+// The recompiler's push constants (shader_recompiler/resource.h, PushData) at the C++ struct's
+// offsets (checked in vk_rasterizer.cpp); bb_hdr is bbport's, set per draw (vk_rasterizer.cpp).
+layout(push_constant, std430) uniform AuxData {
+    layout(offset = 0) float xoffset;
+    layout(offset = 4) float yoffset;
+    layout(offset = 8) float xscale;
+    layout(offset = 12) float yscale;
+    layout(offset = 80) uvec4 buf_offsets0;
+    layout(offset = 96) uvec4 buf_offsets1;
+    layout(offset = 112) uvec2 buf_offsets2;
+    layout(offset = 120) uint motion_param;
+    layout(offset = 124) uint scene_size;
+    layout(offset = 128) uvec4 bb_hdr;
+} push_data;
+
+layout(set = 0, binding = 0) uniform texture2D fs_img0;
+layout(set = 0, binding = 1) uniform texture3D fs_img1;
+layout(set = 0, binding = 2) uniform sampler fs_samp0;
+layout(set = 0, binding = 3) uniform sampler fs_samp1;
+
+BB_INPUT(0, fs_in_attr0);
+layout(location = 0) out vec4 frag_color0;
+
+// The chain's encoding (gamma 2.2, the final pass decodes it so), with the sign kept below 0.
+vec3 signed_pow(vec3 v, float e) {
+    return sign(v) * pow(abs(v), vec3(e));
+}
+
+// The game's table at an encoded color in 0..1, blended with it by the strength.
+vec3 grade(vec3 sdr, float strength) {
+    vec3 graded = max(texture(sampler3D(fs_img1, fs_samp1), sdr * 0.9375 + 0.03125).xyz, 0.0);
+    return mix(sdr, graded, strength);
+}
+
+void main() {
+    vec4 c = textureLod(sampler2D(fs_img0, fs_samp0), BB_UV(fs_in_attr0), 0.0);
+    // bb_hdr.w: the strength's bits plus one (0: not set by bbport, the game's grading).
+    uint bits = push_data.bb_hdr.w;
+    float strength = bits == 0u ? 1.0 : clamp(uintBitsToFloat(bits - 1u), 0.0, 1.0);
+    float top = max(max(c.x, c.y), c.z);
+    vec3 o;
+    if (min(min(c.x, c.y), c.z) >= 0.0) {
+        // Inside BT.709: up to white the table as the game applies it; above, the color divided
+        // by its largest channel (hue and saturation kept), graded, and scaled back up.
+        float scale = max(top, 1.0);
+        o = grade(c.xyz / scale, strength) * scale;
+    } else {
+        // The bridge, in linear light: into BT.709, into the table's range, graded, back out.
+        vec3 linear = signed_pow(c.xyz, 2.2);
+        float gamut_scale = bb_gamut_compression_scale(linear);
+        vec3 inside = gamut_scale < 1.0 ? bb_gamut_compress(linear, gamut_scale) : linear;
+        inside = max(inside, 0.0);
+        float range_scale = 1.0 / max(max(max(inside.x, inside.y), inside.z), 1.0);
+        vec3 graded = signed_pow(grade(signed_pow(inside * range_scale, 1.0 / 2.2), strength), 2.2) /
+                      range_scale;
+        if (gamut_scale < 1.0) {
+            graded = bb_gamut_decompress(graded, gamut_scale);
+        }
+        o = signed_pow(graded, 1.0 / 2.2);
+    }
+    // The game's channel order: its target holds them swapped.
+    frag_color0 = vec4(o.zyx, max(c.w, 0.0));
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_composite.glsl b/gpu/shadps4/video_core/host_shaders/hdr/bb_composite.glsl
new file mode 100644
index 0000000..a7a15cc
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_composite.glsl
@@ -0,0 +1,202 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// bbport HDR: Bloodborne's final composite (bloom + tone curve + color matrix + gamma), all 1380
+// standard variants of renderer_vulkan/bb_tonemap_variants.h, as Native+'s composite reads it
+// (hdr/bb_composite_hdr.frag). Written from the game's code of every variant and checked against
+// it.
+//
+// The includer defines float bb_c(uint word): the composite's constant buffer, by word.
+//
+// The game's math (x: the exposed scene, before the curve):
+//   ms   = tint(mult; 752, 753, 756) * c754 + c755          scene tint (mult: 1x1 texture)
+//   mb   = clamp(tint(mult; 744, 745, 748)) * c746 + c747   bloom base
+//   x    = pre(scene) * c616 * vignettes * ms                (c616: 1 in variants without it)
+//          or, scene matrix variants: (A (pre(scene) * ms) + a) * vignettes  (3x4, words 856..867)
+//   T    = curve(x)                                         per channel or on the mean of RGB
+//   g    = c617 * (mb + bloom * ms), or max(B (mb + bloom * ms) + b, 0)  (3x4, words 872..883)
+//   U    = clamp(g);  S = T + U - T U   (screen blend; additive variants: S = x + g, no max)
+//   out  = M S + offsets  (3x4, words 840..851; S itself in variants without it), then pow(clamp(out), c808) when gamma-encoded
+// tint(t; s, b, sat) = mean + sat * (t * c[s] + c[b] - mean) around the mean of the scaled RGB.
+
+#ifndef BBPORT_BB_COMPOSITE_GLSL
+#define BBPORT_BB_COMPOSITE_GLSL
+
+struct BbComposite {
+    int curve;      // 0 exp, 1 extended Reinhard, 2 log, 3 none
+    bool luminance; // curve on the mean of RGB
+    int pre;        // pre-exposure: 0 none, 1 sqrt form (16-19), 2 exp form (8-11), 3 alpha (12-15)
+    bool pre_lum;   // pre-exposure on the mean of RGB
+    bool cos4;      // (1 - r^2)^4 vignette
+    bool vig888;    // lens vignette (888-892)
+    bool gamma;     // output encoded with c808
+    bool additive;  // no curve, bloom added, unclamped (HDR output for a later pass)
+    bool gain;      // scene gain c616 (else 1)
+    bool floor;     // curve input raised to BB_FLOOR first
+    bool scene_mat; // 3x4 matrix on the tinted scene (856..867), vignettes after it
+    bool glow_mat;  // 3x4 matrix on the glow (872..883) instead of c617
+    bool grade;     // color matrix 840..851 (else the screen blend is the output)
+};
+
+// A 3x4 matrix of the constant buffer (rows at base, base + 4, base + 8; offsets in column 3).
+vec3 bb_mat34(uint base, vec3 v) {
+    return vec3(bb_c(base) * v.r + bb_c(base + 1u) * v.g + bb_c(base + 2u) * v.b + bb_c(base + 3u),
+                bb_c(base + 4u) * v.r + bb_c(base + 5u) * v.g + bb_c(base + 6u) * v.b + bb_c(base + 7u),
+                bb_c(base + 8u) * v.r + bb_c(base + 9u) * v.g + bb_c(base + 10u) * v.b + bb_c(base + 11u));
+}
+
+const float BB_FLOOR = 6.103515625e-05;   // 2^-14: scene floor before the curves
+const float BB_EPS = 2.384185791015625e-07; // 2^-22: added before log2 / rcp
+const float BB_THIRD = 0.3333333432674407958984375;
+
+float bb_mean(vec3 v) {
+    return v.r * BB_THIRD + v.g * BB_THIRD + v.b * BB_THIRD;
+}
+
+vec3 bb_tint(vec3 t, uint scale, uint bias, uint saturation) {
+    vec3 s = t * bb_c(scale) + bb_c(bias);
+    float mean = bb_mean(s);
+    return bb_c(saturation) * (s - mean) + mean;
+}
+
+vec3 bb_scene_tint(vec3 mult) {
+    return bb_tint(mult, 752u, 753u, 756u) * bb_c(754u) + bb_c(755u);
+}
+
+vec3 bb_bloom_base(vec3 mult) {
+    return clamp(bb_tint(mult, 744u, 745u, 748u), 0.0, 1.0) * bb_c(746u) + bb_c(747u);
+}
+
+float bb_vignettes(BbComposite o, vec2 uv) {
+    float f = 1.0;
+    float r2 = dot(uv, uv);
+    if (o.cos4) {
+        float a = clamp(1.0 - r2, 0.0, 1.0);
+        a *= a;
+        f *= a * a;
+    }
+    if (o.vig888) {
+        float r = sqrt(r2);
+        float a = clamp(bb_c(888u) * r + bb_c(889u), 0.0, 1.0);
+        float s = max(min(bb_c(891u), 3.0 * a * a - 2.0 * a * a * a), 0.0);
+        float d = bb_c(890u) * r;
+        f *= s * exp2(bb_c(892u) * log2(1.0 / (d * d + 1.0)));
+    }
+    return f;
+}
+
+float bb_pre(int kind, float v) {
+    if (kind == 1) {
+        return bb_c(19u) * (v + sqrt(v * (v + bb_c(16u)) + 1.0) - 1.0);
+    }
+    return bb_c(11u) * (exp2(bb_c(8u) * v * 1.44269502162933349609375) - 1.0);
+}
+
+// The exposed scene x (before the curve).
+vec3 bb_exposed(BbComposite o, vec4 scene, vec3 ms, vec2 vig_uv) {
+    float gain = (o.gain ? bb_c(616u) : 1.0) * bb_vignettes(o, vig_uv);
+    vec3 sc = scene.rgb;
+    if (o.pre == 3) {
+        float a = clamp(scene.a, 0.0, 1.0);
+        sc = clamp(sc, 0.0, 1.0) * (bb_c(12u) * (bb_c(14u) * a * a + 1.0));
+    } else if (o.pre != 0 && o.pre_lum) {
+        float l = bb_mean(sc);
+        sc *= bb_pre(o.pre, l) / (l + BB_EPS);
+    } else if (o.pre != 0) {
+        sc = vec3(bb_pre(o.pre, sc.r), bb_pre(o.pre, sc.g), bb_pre(o.pre, sc.b));
+    }
+    if (o.scene_mat) {
+        return bb_mat34(856u, sc * ms) * gain;
+    }
+    return sc * gain * ms;
+}
+
+// The glow before its clamp (g above).
+vec3 bb_glow(BbComposite o, vec3 base, vec3 bloom, vec3 ms) {
+    vec3 g = base + bloom * ms;
+    if (!o.glow_mat) {
+        return bb_c(617u) * g;
+    }
+    g = bb_mat34(872u, g);
+    return o.additive ? g : max(g, 0.0);
+}
+
+// The curve's function, unclamped (v >= BB_FLOOR).
+float bb_f(int curve, float v) {
+    if (curve == 0) {
+        float y = 1.0 - exp2(-(v * bb_c(832u)) * 1.44269502162933349609375);
+        float k = bb_c(833u) * (y - 1.0) + 1.0;
+        return y * k * k;
+    }
+    if (curve == 1) {
+        float a = bb_c(833u), b = bb_c(834u);
+        float u = a * v;
+        return (u + u * u * b) / (u + 1.0);
+    }
+    return bb_c(833u) * (log2(bb_c(834u) * v + 1.0) * 0.693147182464599609375);
+}
+
+// The game's curve: T in [0, 1].
+vec3 bb_curve(BbComposite o, vec3 x) {
+    if (o.curve == 3) {
+        return clamp(x, 0.0, 1.0);
+    }
+    if (o.floor) {
+        x = max(x, BB_FLOOR);
+    }
+    if (!o.luminance) {
+        return clamp(vec3(bb_f(o.curve, x.r), bb_f(o.curve, x.g), bb_f(o.curve, x.b)), 0.0, 1.0);
+    }
+    float l = bb_mean(x);
+    float t = bb_f(o.curve, l);
+    if (o.curve != 1) {
+        t = clamp(t, 0.0, 1.0); // the game clamps the log value, not the Reinhard one
+    }
+    return clamp(x * (t / (l + BB_EPS)), 0.0, 1.0);
+}
+
+// Where the curve reaches `target` (< 1): input and slope there. False if it does not.
+bool bb_knee(int curve, float target, out float v, out float slope) {
+    if (curve == 3) {
+        v = target;
+        slope = 1.0;
+        return true;
+    }
+    if (curve == 0) {
+        float k = bb_c(832u), c = bb_c(833u);
+        float y = target;
+        for (int i = 0; i < 8; ++i) { // Newton on y: y (c (y - 1) + 1)^2 = target
+            float a = c * y - c + 1.0;
+            y -= (y * a * a - target) / (a * a + 2.0 * c * y * a);
+        }
+        y = clamp(y, 0.0, 0.999999);
+        float a = c * y - c + 1.0;
+        v = -log(1.0 - y) / k;
+        slope = (a * a + 2.0 * c * y * a) * k * (1.0 - y);
+    } else if (curve == 1) {
+        float a = bb_c(833u), b = bb_c(834u);
+        // b u^2 + (1 - target) u - target = 0
+        float u = b > 1e-6 ? (sqrt((1.0 - target) * (1.0 - target) + 4.0 * b * target) -
+                              (1.0 - target)) / (2.0 * b)
+                           : target / (1.0 - target);
+        v = u / a;
+        slope = a * ((1.0 + 2.0 * b * u) * (1.0 + u) - (u + b * u * u)) / ((1.0 + u) * (1.0 + u));
+    } else {
+        float a = bb_c(833u), b = bb_c(834u);
+        v = (exp(target / a) - 1.0) / b;
+        slope = a * b / (1.0 + b * v);
+    }
+    return v > 0.0 && slope > 0.0 && !isinf(v) && !isnan(v) && !isnan(slope);
+}
+
+// The game's color matrix, rows 840, 844 and 848 (+ offsets 843, 847, 851), in export order.
+vec3 bb_grade(BbComposite o, vec3 s) {
+    if (!o.grade) {
+        return s;
+    }
+    return vec3(bb_c(840u) * s.r + bb_c(841u) * s.g + bb_c(842u) * s.b + bb_c(843u),
+                bb_c(844u) * s.r + bb_c(845u) * s.g + bb_c(846u) * s.b + bb_c(847u),
+                bb_c(848u) * s.r + bb_c(849u) * s.g + bb_c(850u) * s.b + bb_c(851u));
+}
+
+#endif // BBPORT_BB_COMPOSITE_GLSL
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_composite_hdr.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_composite_hdr.frag
new file mode 100644
index 0000000..bc73e9c
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_composite_hdr.frag
@@ -0,0 +1,495 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Native+: the tone mapped scene for any of the 1380 standard variants of Bloodborne's final
+// composite (bb_tonemap_variants.h). The game draws its composite unchanged; this shader is drawn
+// right after it, with the same inputs, into the same (RGBA16F) target, with additive blending
+// and color writes only: frag_color0 is the HDR output minus the game's (both encoded as the game
+// encodes, before its grain), so the target ends up with the HDR color plus the game's grain and
+// alpha. Its interface is the game shader's: HdrChannel copies the variant's descriptor bindings,
+// input locations and constant-buffer slot onto the decorations named bb_* here, and sets the
+// variant's options as specialization constants (vk_hdr_channel.cpp). The game's math is
+// hdr/bb_composite.glsl.
+
+#version 450
+#ifndef BB_HW_INTERP
+#extension GL_EXT_fragment_shader_barycentric : require
+#endif
+#ifdef BB_CB_UBO
+#extension GL_EXT_scalar_block_layout : require
+#endif
+#extension GL_GOOGLE_include_directive : require
+
+#include "bb_inputs.glsl"
+
+layout(constant_id = 10) const int BB_CURVE = 0;
+layout(constant_id = 11) const bool BB_LUMINANCE = false;
+layout(constant_id = 12) const int BB_PRE = 0;
+layout(constant_id = 13) const bool BB_PRE_LUM = false;
+layout(constant_id = 14) const bool BB_COS4 = false;
+layout(constant_id = 15) const bool BB_VIG888 = false;
+layout(constant_id = 16) const bool BB_GAMMA = true;
+layout(constant_id = 17) const bool BB_ADDITIVE = false;
+layout(constant_id = 18) const uint BB_BUFFER_INDEX = 0u; // index of the constant buffer in buf_offsets
+layout(constant_id = 20) const bool BB_GAIN = true;
+layout(constant_id = 21) const bool BB_FLOOR_ON = true;
+layout(constant_id = 22) const bool BB_SCENE_MAT = false;
+layout(constant_id = 23) const bool BB_GLOW_MAT = false;
+layout(constant_id = 24) const bool BB_GRADE = true;
+
+// The game shader's constant buffer (decorations copied from the variant): a storage buffer from
+// the legacy shader compiler (ssbo_N); BB_CB_UBO, a uniform buffer of 16384 dwords with a 4-byte
+// stride from Lantern's native one (ubo_N, Profile::uniform_dword_layout).
+#ifdef BB_CB_UBO
+layout(set = 0, binding = 0, scalar) uniform bb_ssbo_block {
+    uint data[16384];
+} bb_ssbo;
+#else
+layout(set = 0, binding = 0, std430) readonly buffer bb_ssbo_block {
+    uint data[];
+} bb_ssbo;
+#endif
+
+// The recompiler's push constants (shader_recompiler/resource.h, PushData) at the C++ struct's
+// offsets (checked in vk_rasterizer.cpp); bb_hdr is bbport's, set per draw (vk_rasterizer.cpp).
+layout(push_constant, std430) uniform AuxData {
+    layout(offset = 0) float xoffset;
+    layout(offset = 4) float yoffset;
+    layout(offset = 8) float xscale;
+    layout(offset = 12) float yscale;
+    layout(offset = 80) uvec4 buf_offsets0;
+    layout(offset = 96) uvec4 buf_offsets1;
+    layout(offset = 112) uvec2 buf_offsets2;
+    layout(offset = 120) uint motion_param;
+    layout(offset = 124) uint scene_size;
+    layout(offset = 128) uvec4 bb_hdr;
+    // bb_hdr.w: the menu's Bloom (bits plus one, 0: the game's). bb_hdr2a: x the display's peak
+    // (game white units), y exposure, z highlights, w shadows; bb_hdr2b: x contrast,
+    // y saturation (each a float's bits plus one, 0: not set), z the target gamut (PsychoV-30's
+    // gamut_compression_mode: 0 BT.709, 1 BT.2020) + 4 for Vanilla+ or 16 for PsychoV + PsychoV's
+    // Vanilla+ Highlights in percent from bit 8, its Vanilla+ Shadows from bit 16 and Keep Deeper
+    // Blacks in bit 23, plus one; w PsychoV's Hue Correction, 0..1.
+    layout(offset = 144) uvec4 bb_hdr2a;
+    layout(offset = 160) uvec4 bb_hdr2b;
+} push_data;
+
+layout(set = 0, binding = 1) uniform texture2D bb_img_scene;
+layout(set = 0, binding = 2) uniform texture2D bb_img_mult;
+layout(set = 0, binding = 3) uniform texture2D bb_img_bloom;
+layout(set = 0, binding = 4) uniform sampler bb_samp_scene;
+layout(set = 0, binding = 5) uniform sampler bb_samp_mult;
+layout(set = 0, binding = 6) uniform sampler bb_samp_bloom;
+
+// The game's inputs, per vertex or interpolated by the GPU (bb_inputs.glsl); their locations are
+// the variant's (vk_hdr_channel.cpp).
+BB_INPUT(0, bb_in_scene);
+BB_INPUT(1, bb_in_mult);
+BB_INPUT(2, bb_in_bloom);
+BB_INPUT(3, bb_in_vig);
+
+layout(location = 0) out vec4 frag_color0;
+
+uint buf_off;
+
+float bb_c(uint word) {
+    return uintBitsToFloat(bb_ssbo.data[word + buf_off]);
+}
+
+#include "bb_composite.glsl"
+#include "psychov30.glsl"
+
+float bb_bits(uint bits, float fallback) {
+    return bits == 0u ? fallback : uintBitsToFloat(bits - 1u);
+}
+
+// The chain's gamma encoding (`power`, the game's 1/2.2) with the sign kept for channels below 0
+// (BT.2020 colors outside BT.709): exactly the unsigned encoding for the others.
+vec3 bb_encode_signed(vec3 v, float power) {
+    vec3 positive = exp2(power * log2(max(v, 0.0) + BB_EPS));
+    vec3 negative = exp2(power * log2(max(-v, 0.0) + BB_EPS)) - exp2(power * log2(BB_EPS));
+    return positive - negative;
+}
+
+// The value plus one in `word` (0: not set, `fallback`).
+int bb_choice(uint word, int fallback) {
+    return word == 0u ? fallback : int(word - 1u);
+}
+
+// The display's peak in units of the game's white (bb_hdr2a.x).
+float bb_peak() {
+    return max(bb_bits(push_data.bb_hdr2a.x, 1.0), 1.0);
+}
+
+// PsychoV-30 alone on the scene's linear color, in place of the game's curve, to the display's
+// peak (the final pass then only encodes): PsychoV where the composite has no curve to extend
+// (curve 3). Anchored where the game's curve gives mid grey (0.18), with the game's log-log slope there (x V'(x) / V(x)) as
+// cone_response_exponent, as RenoDX's mods pass a vanilla slope (cp2077, orderofthesinkingstar):
+// test30's cone power is contrast * cone_response_exponent but its purity purity_scale /
+// contrast, so the game's slope passed as contrast also took purity down (by 1 / 1.05 to
+// 1 / 1.17 in the scenes measured). The menu's exposure, highlights, shadows, contrast and
+// saturation are PsychoV-30's own parameters (neutral at 1), its target gamut BT.2020, as
+// RenoDX's HDR mods.
+float bb_vanilla_plus_f(int curve, float v);
+
+// The anchor (the scene's mid grey for the game's curve) and the cone (the game's log-log slope
+// there) PsychoV-30 takes; false without a curve to read them from.
+bool bb_psychov_anchor(BbComposite o, out float grey_in, out float cone) {
+    float slope;
+    grey_in = 0.18;
+    cone = 1.0;
+    if (!bb_knee(o.curve, 0.18, grey_in, slope)) {
+        return false;
+    }
+    cone = clamp(grey_in * slope / 0.18, 0.3, 3.0);
+    return true;
+}
+
+// PsychoV-30 with the menu's parameters on a scene color, anchored at grey_in with that cone.
+vec3 bb_psychov(vec3 x, float grey_in, float game_contrast) {
+    float peak = bb_peak();
+    float exposure = bb_bits(push_data.bb_hdr2a.y, 1.0);
+    float highlights = bb_bits(push_data.bb_hdr2a.z, 1.0);
+    float shadows = bb_bits(push_data.bb_hdr2a.w, 1.0);
+    float contrast = bb_bits(push_data.bb_hdr2b.x, 1.0);
+    float purity = bb_bits(push_data.bb_hdr2b.y, 1.0);
+    // bb_hdr2b.z: the gamut (1 BT.2020) plus the tone mapper's bits, + 1. Gamut compression and
+    // compression: RenoDX's defaults, 1 and 1.
+    int gamut = clamp(bb_choice(push_data.bb_hdr2b.z, 1) & 1, 0, 1);
+    const float gamut_compression = 1.0, compression = 1.0;
+    vec3 t = rd_psychov30(x, peak, exposure, highlights, shadows, max(contrast, 0.05), purity,
+                          game_contrast, vec3(grey_in), vec3(0.18), gamut_compression, gamut,
+                          compression, RD_PSY30_SOURCE_BOUNDARY_BT709);
+    // BT.2020: a color outside BT.709 has BT.709 channels below 0. They are kept, signed, through
+    // the 16-bit chain to the final pass, which converts to BT.2020 before it drops what is still
+    // negative (as RenoDX's mods). BT.709: within the cube, as before.
+    return gamut == 0 ? max(t, 0.0) : t;
+}
+
+bool bb_curve_psychov_scene(BbComposite o, vec3 x, out vec3 t) {
+    float grey_in, cone;
+    if (!bb_psychov_anchor(o, grey_in, cone)) {
+        t = bb_curve(o, x);
+        return false;
+    }
+    if (o.curve != 3) {
+        x = max(x, BB_FLOOR); // PsychoV-30 needs a positive input
+    }
+    t = bb_psychov(x, grey_in, cone);
+    return true;
+}
+
+// Tone mapper PsychoV (+ 16). PsychoV-30 with this anchor and cone maps a grey as a display map (mid
+// grey to mid grey, cone 1) maps the signal v = 0.18 (x / grey_in)^cone: PsychoV-30's own curve.
+// Above grey_in, the menu's Vanilla+ Highlights (`highlights`, 0..1) mixes v in the log with
+// Vanilla+'s extended curve (the game's tangent from mid grey; scaled to 0.18 at grey_in, where the
+// two meet), as the FromSoftware RenoDX mod feeds PsychoV a vanilla curve continued above mid grey:
+// at 1 the highlights have Vanilla+'s brightness, PsychoV-30 still compressing them to the peak.
+// On the luminance, the color's ratios kept, then in Vanilla+'s order: the bloom added to v (no
+// screen blend, whose per-channel clamp turned an orange glow yellow-green), the game's color
+// matrix, then PsychoV-30 on the scene color whose v that is (bb_psychov_vplus_rows), then the
+// menu's Hue Correction towards Vanilla+'s hues (bb_psychov_vplus_graded).
+const vec3 BB_Y709 = vec3(0.2126390059, 0.7151686788, 0.0721923154);
+
+bool bb_curve_psychov_vplus(BbComposite o, vec3 x, float highlights, out vec3 v) {
+    float grey_in, cone;
+    if (!bb_psychov_anchor(o, grey_in, cone)) {
+        v = bb_curve(o, x);
+        return false;
+    }
+    x = max(x, BB_FLOOR);
+    float y = dot(x, BB_Y709);
+    float signal = 0.18 * pow(y / grey_in, cone);
+    if (y > grey_in && highlights > 0.0) {
+        float vanilla_plus =
+            bb_vanilla_plus_f(o.curve, y) * (0.18 / bb_vanilla_plus_f(o.curve, grey_in));
+        signal = exp(mix(log(signal), log(max(vanilla_plus, BB_FLOOR)), highlights));
+    }
+    v = x * (signal / y);
+    return true;
+}
+
+vec3 bb_psychov_vplus_rows(BbComposite o, vec3 rows) {
+    float grey_in, cone;
+    bb_psychov_anchor(o, grey_in, cone);
+    rows = max(rows, BB_FLOOR);
+    float y = dot(rows, BB_Y709);
+    return bb_psychov(rows * (grey_in * pow(y / 0.18, 1.0 / cone) / y), grey_in, cone);
+}
+
+// Tone mapper Vanilla+ (+ 4), as RenoDX's Bloodborne mod (souperman9) sets it: the game's curve
+// below an input of mid grey (0.18), its tangent above it (curve 0: the tangent of 1 - e^-kv, the
+// toe after it, as the mod), the bloom added (no screen blend), then RenoDX's user color grading
+// and CInfinityRollOff per channel to the display's peak (bb_vanilla_plus_rows).
+float bb_vanilla_plus_f(int curve, float v) {
+    const float anchor = 0.18;
+    if (v < anchor) {
+        return bb_f(curve, v);
+    }
+    if (curve == 0) {
+        float k = bb_c(832u);
+        float e = exp2(-(anchor * k) * 1.44269502162933349609375);
+        float y = (1.0 - e) + (v - anchor) * k * e;
+        float c = bb_c(833u) * (y - 1.0) + 1.0;
+        return y * c * c;
+    }
+    const float h = 1e-3;
+    float slope = (bb_f(curve, anchor + h) - bb_f(curve, anchor - h)) / (2.0 * h);
+    return bb_f(curve, anchor) + (v - anchor) * max(slope, 0.0);
+}
+
+vec3 bb_curve_vanilla_plus(BbComposite o, vec3 x) {
+    if (o.curve == 3) {
+        return max(x, 0.0);
+    }
+    x = max(x, o.floor ? BB_FLOOR : 0.0);
+    if (o.luminance) {
+        float l = bb_mean(x);
+        return x * (bb_vanilla_plus_f(o.curve, l) / (l + BB_EPS));
+    }
+    return vec3(bb_vanilla_plus_f(o.curve, x.r), bb_vanilla_plus_f(o.curve, x.g),
+                bb_vanilla_plus_f(o.curve, x.b));
+}
+
+// RenoDX's CInfinityRollOff (tonemap/c_infinity_rolloff.hlsl): the value below `anchor`,
+// tending to `peak` above it.
+vec3 bb_c_infinity_rolloff(vec3 c, float peak) {
+    const float anchor = 0.18, strength = 1.5;
+    float range = peak - anchor;
+    vec3 t;
+    for (int i = 0; i < 3; ++i) {
+        float d = max(c[i] - anchor, 0.0);
+        if (d <= 0.0) {
+            t[i] = c[i];
+            continue;
+        }
+        float inverse_position = range / (strength * d);
+        t[i] = range / (strength * inverse_position + exp2(-inverse_position)) + c[i] - d;
+    }
+    return t;
+}
+
+vec3 bb_oklab(vec3 rgb) {
+    vec3 lms = vec3(dot(rgb, vec3(0.4122214615, 0.5363325477, 0.0514459945)),
+                    dot(rgb, vec3(0.2119034976, 0.6806995273, 0.1073969603)),
+                    dot(rgb, vec3(0.0883024633, 0.2817188501, 0.6299787164)));
+    lms = sign(lms) * pow(abs(lms), vec3(1.0 / 3.0));
+    return vec3(dot(lms, vec3(0.2104542553, 0.7936177850, -0.0040720468)),
+                dot(lms, vec3(1.9779984951, -2.4285922050, 0.4505937099)),
+                dot(lms, vec3(0.0259040371, 0.7827717662, -0.8086757660)));
+}
+
+vec3 bb_oklab_to_rgb(vec3 lab) {
+    vec3 lms = vec3(lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z,
+                    lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z,
+                    lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z);
+    lms = lms * lms * lms;
+    return vec3(dot(lms, vec3(4.0767416621, -3.3077115913, 0.2309699292)),
+                dot(lms, vec3(-1.2684380046, 2.6097574011, -0.3413193965)),
+                dot(lms, vec3(-0.0041960863, -0.7034186147, 1.7076147010)));
+}
+
+// RenoDX's user color grading as the Bloodborne mod applies it before its roll-off (exposure,
+// contrast, highlights, shadows on the luminance around mid grey; the new lightness with the
+// original hue in OKLab; saturation), then no color below 0 in BT.2020.
+vec3 bb_renodx_user_grade(vec3 c, float exposure, float highlights, float shadows,
+                          float contrast, float saturation) {
+    vec3 exposed = c * exposure;
+    float y = dot(exposed, vec3(0.2126390059, 0.7151686788, 0.0721923154));
+    float scale = 0.0;
+    if (y > 0.0) {
+        float a = pow(y / 0.18, contrast);
+        float b = mix(a, pow(a, highlights), clamp(a, 0.0, 1.0));
+        scale = mix(pow(b, 2.0 - shadows), b, clamp(b, 0.0, 1.0)) * 0.18 / y;
+    }
+    vec3 graded = bb_oklab(exposed * scale);
+    vec3 original = bb_oklab(c);
+    float chroma = length(original.yz);
+    vec2 ab = chroma > 0.0 ? original.yz * (length(graded.yz) / chroma) : graded.yz;
+    vec3 rgb = bb_oklab_to_rgb(vec3(graded.x, ab * saturation));
+    vec3 bt2020 = max(vec3(dot(rgb, vec3(0.6130974024, 0.3395231462, 0.0473794514)),
+                           dot(rgb, vec3(0.0701937225, 0.9163538791, 0.0134523985)),
+                           dot(rgb, vec3(0.0206155929, 0.1095697729, 0.8698146343))),
+                      0.0);
+    return vec3(dot(bt2020, vec3(1.7050509927, -0.6217921207, -0.0832588720)),
+                dot(bt2020, vec3(-0.1302564175, 1.1408047366, -0.0105483191)),
+                dot(bt2020, vec3(-0.0240033568, -0.1289689761, 1.1529723430)));
+}
+
+// Vanilla+ after the game's color matrix (rows in RGB order): the menu's grading, then the
+// roll-off to the display's peak (in units of the game's white).
+vec3 bb_vanilla_plus_rows(vec3 rows) {
+    rows = max(rows, 0.0);
+    float exposure = bb_bits(push_data.bb_hdr2a.y, 1.0);
+    float highlights = bb_bits(push_data.bb_hdr2a.z, 1.0);
+    float shadows = bb_bits(push_data.bb_hdr2a.w, 1.0);
+    float contrast = bb_bits(push_data.bb_hdr2b.x, 1.0);
+    float saturation = bb_bits(push_data.bb_hdr2b.y, 1.0);
+    if (exposure != 1.0 || highlights != 1.0 || shadows != 1.0 || contrast != 1.0 ||
+        saturation != 1.0) {
+        rows = bb_renodx_user_grade(rows, exposure, highlights, shadows, contrast, saturation);
+    }
+    return bb_c_infinity_rolloff(rows, bb_peak());
+}
+
+// RenoDX's hue correction (colorcorrect.hlsl, HueOKLab): the color's lightness, its (a, b) moved
+// towards the reference's by `strength`, then scaled back to the color's chroma.
+vec3 bb_correct_hue(vec3 c, vec3 reference, float strength) {
+    vec3 lab = bb_oklab(c);
+    float chroma = length(lab.yz);
+    vec2 ab = mix(lab.yz, bb_oklab(reference).yz, strength);
+    float blended = length(ab);
+    if (blended > 0.0) {
+        lab.yz = ab * (chroma / blended);
+    }
+    return bb_oklab_to_rgb(lab);
+}
+
+// PsychoV's Hue Correction (the in-game menu's, 0..1; bb_hdr2b.w).
+float bb_hue_correction() {
+    return clamp(bb_bits(push_data.bb_hdr2b.w, 0.0), 0.0, 1.0);
+}
+
+// PsychoV's Vanilla+ Shadows (the in-game menu's, 0..1; bits 16 to 22 of bb_hdr2b.z).
+float bb_vplus_shadows() {
+    return clamp(float((bb_choice(push_data.bb_hdr2b.z, 1) >> 16) & 0x7F) / 100.0, 0.0, 1.0);
+}
+
+// Its Keep Deeper Blacks (bit 23): Vanilla+ Shadows only takes the shadows down.
+bool bb_vplus_shadows_deeper() {
+    return ((bb_choice(push_data.bb_hdr2b.z, 1) >> 23) & 1) != 0;
+}
+
+// PsychoV after the game's matrix (rows in RGB order), its hue moved towards
+// Vanilla+'s by the menu's Hue Correction (0 by default): PsychoV-30's
+// compression of each cone moves a bright orange towards yellow and a violet towards pink (as the
+// eye sees a strong light); the game's curve, per channel, keeps the artists' hues. Lightness,
+// chroma and peak stay PsychoV-30's; the reference is Vanilla+'s output for the same pixel (its
+// curve and bloom, matrix, roll-off without the menu's grading, whose sliders are PsychoV-30's here).
+// Below mid grey, the menu's Vanilla+ Shadows (0 by default) takes the luminance towards that
+// reference's, the game's own curve there, in the log, the color's ratios kept (PsychoV's hue and
+// chroma); with Keep Deeper Blacks only where the reference is darker (PsychoV's own blacks where
+// they are deeper). It works on the output: PsychoV-30 is darker there than the signal it is given
+// (its own toe), so taking the signal towards Vanilla+'s would only move part of the way.
+vec3 bb_psychov_vplus_graded(BbComposite o, vec3 hdr_screen, vec3 vanilla_plus_screen) {
+    vec3 t = bb_psychov_vplus_rows(o, bb_grade(o, hdr_screen));
+    float hue = bb_hue_correction(), shadows = bb_vplus_shadows();
+    if (hue > 0.0 || shadows > 0.0) {
+        vec3 reference =
+            bb_c_infinity_rolloff(max(bb_grade(o, vanilla_plus_screen), 0.0), bb_peak());
+        if (hue > 0.0) {
+            t = bb_correct_hue(t, reference, hue);
+        }
+        float y = dot(t, BB_Y709), y_reference = dot(reference, BB_Y709);
+        if (shadows > 0.0 && y > BB_FLOOR && y_reference > BB_FLOOR) {
+            float weight = shadows * (1.0 - smoothstep(0.09, 0.18, max(y, y_reference)));
+            float ratio = y_reference / y;
+            t *= exp2(weight * log2(bb_vplus_shadows_deeper() ? min(ratio, 1.0) : ratio));
+        }
+    }
+    return (bb_choice(push_data.bb_hdr2b.z, 1) & 1) == 0 ? max(t, 0.0) : t;
+}
+
+#ifndef BB_HW_INTERP
+// The game's interpolation, as recompiled: attribute with the barycentrics.
+vec2 interp(vec4 a0, vec4 a1, vec4 a2) {
+    vec3 b = gl_BaryCoordEXT;
+    return vec2(fma(a2.x - a0.x, b.z, fma(a1.x - a0.x, b.y, a0.x)),
+                fma(a2.y - a0.y, b.z, fma(a1.y - a0.y, b.y, a0.y)));
+}
+#define BB_IN_UV(NAME) interp(NAME[0], NAME[1], NAME[2])
+#else
+#define BB_IN_UV(NAME) BB_UV(NAME)
+#endif
+
+void main() {
+    // buf_offsets holds one byte per buffer binding, as the recompiler reads it:
+    // buf_offsets0 = buffers 0..15, buf_offsets1 = 16..31.
+    uvec4 offsets = BB_BUFFER_INDEX < 16u ? push_data.buf_offsets0 : push_data.buf_offsets1;
+    uint slot = BB_BUFFER_INDEX & 15u;
+    buf_off = bitfieldExtract(offsets[slot >> 2u], int((slot & 3u) * 8u), 8) >> 2u;
+
+    BbComposite o = BbComposite(BB_CURVE, BB_LUMINANCE, BB_PRE, BB_PRE_LUM, BB_COS4, BB_VIG888,
+                                BB_GAMMA, BB_ADDITIVE, BB_GAIN, BB_FLOOR_ON, BB_SCENE_MAT,
+                                BB_GLOW_MAT, BB_GRADE);
+
+    vec4 scene = textureLod(sampler2D(bb_img_scene, bb_samp_scene), BB_IN_UV(bb_in_scene), 0.0);
+    vec3 mult = texture(sampler2D(bb_img_mult, bb_samp_mult), BB_IN_UV(bb_in_mult)).rgb;
+    vec3 bloom = textureLod(sampler2D(bb_img_bloom, bb_samp_bloom), BB_IN_UV(bb_in_bloom), 0.0).rgb;
+    vec2 vig_uv = (BB_COS4 || BB_VIG888) ? BB_IN_UV(bb_in_vig) : vec2(0.0);
+    // The game's output, and the same with the tone mapper's curve.
+    vec3 ms = bb_scene_tint(mult);
+    vec3 x = bb_exposed(o, scene, ms, vig_uv);
+    vec3 base = bb_bloom_base(mult);
+    vec3 sdr_t = bb_curve(o, x);
+    vec3 hdr_t;
+    int tone_mapper = bb_choice(push_data.bb_hdr2b.z, 1);
+    bool vanilla_plus = (tone_mapper & 4) != 0;
+    // PsychoV (16), its Vanilla+ Highlights in percent from bit 8.
+    bool psychov_vplus = (tone_mapper & 16) != 0 && o.curve != 3;
+    float psychov_highlights = clamp(float((tone_mapper >> 8) & 0x7F) / 100.0, 0.0, 1.0);
+    // Vanilla+ and PsychoV add the bloom to their curve, before the game's matrix.
+    bool added_bloom = vanilla_plus || psychov_vplus;
+    bool has_hdr = false;
+    if (!BB_ADDITIVE && vanilla_plus) {
+        hdr_t = bb_curve_vanilla_plus(o, x);
+        has_hdr = true;
+    } else if (!BB_ADDITIVE && psychov_vplus) {
+        has_hdr = bb_curve_psychov_vplus(o, x, psychov_highlights, hdr_t);
+    } else if (!BB_ADDITIVE) {
+        has_hdr = bb_curve_psychov_scene(o, x, hdr_t);
+    }
+    vec3 g = bb_glow(o, base, bloom, ms);
+    vec3 glow = clamp(g, 0.0, 1.0);
+    vec3 sdr_screen = BB_ADDITIVE ? x + g : sdr_t + glow - sdr_t * glow;
+    // Screen blend on the SDR part only (above 1 it would subtract); Vanilla+ adds the bloom.
+    vec3 hdr_screen = !has_hdr     ? sdr_screen
+                      : added_bloom ? max(hdr_t + g, 0.0)
+                                    : hdr_t + glow * (1.0 - min(hdr_t, 1.0));
+
+    // Export order is rows 840, 844, 848; the game's target holds them as BGR (row 848 first),
+    // hence .zyx.
+    vec3 sdr_graded = bb_grade(o, sdr_screen).zyx;
+    // The reference of Hue Correction and Vanilla+ Shadows: Vanilla+'s curve for the same pixel.
+    bool vplus_reference =
+        psychov_vplus && (bb_hue_correction() > 0.0 || bb_vplus_shadows() > 0.0);
+    vec3 vplus_t = vplus_reference ? bb_curve_vanilla_plus(o, x) : vec3(0.0);
+    vec3 hdr_graded = psychov_vplus  ? bb_psychov_vplus_graded(o, hdr_screen, max(vplus_t + g, 0.0)).zyx
+                      : vanilla_plus ? bb_vanilla_plus_rows(bb_grade(o, hdr_screen)).zyx
+                                     : bb_grade(o, hdr_screen).zyx;
+    // The game's bloom, live (the menu's Bloom; bb_hdr.w: the strength's bits plus one, 0 = the
+    // game's): the target is the composite with its glow scaled, so the difference can also take
+    // light away.
+    uint bloom_bits = push_data.bb_hdr.w;
+    float k = (bloom_bits == 0u || BB_ADDITIVE) ? 1.0
+                                                : clamp(uintBitsToFloat(bloom_bits - 1u), 0.0, 4.0);
+    bool scaled = abs(k - 1.0) > 1e-3;
+    vec3 target = has_hdr ? hdr_graded : clamp(sdr_graded, 0.0, 1.0);
+    if (scaled) {
+        vec3 glow_k = clamp(g * k, 0.0, 1.0);
+        vec3 sdr_screen_k = sdr_t + glow_k - sdr_t * glow_k;
+        vec3 hdr_screen_k = !has_hdr     ? sdr_screen_k
+                            : added_bloom ? max(hdr_t + g * k, 0.0)
+                                          : hdr_t + glow_k * (1.0 - min(hdr_t, 1.0));
+        target = !has_hdr      ? clamp(bb_grade(o, sdr_screen_k).zyx, 0.0, 1.0)
+                 : psychov_vplus ? bb_psychov_vplus_graded(o, hdr_screen_k,
+                                                           max(vplus_t + g * k, 0.0)).zyx
+                 : vanilla_plus ? bb_vanilla_plus_rows(bb_grade(o, hdr_screen_k)).zyx
+                                : bb_grade(o, hdr_screen_k).zyx;
+    }
+    // The game's own output in the target (the delta goes over it), and the HDR one. A BT.2020
+    // target leaves channels below 0: kept, signed (RGBA16F, additive blending).
+    vec3 game_out = BB_GAMMA ? exp2(bb_c(808u) * log2(clamp(sdr_graded + BB_EPS, 0.0, 1.0)))
+                             : clamp(sdr_graded, 0.0, 1.0);
+    vec3 delta = vec3(0.0);
+    if (has_hdr || scaled) {
+        vec3 hdr_out = BB_GAMMA ? bb_encode_signed(target, bb_c(808u)) : target;
+        delta = hdr_out - game_out;
+    }
+    // The tone mappers replace the game's curve, so the delta may also darken.
+    frag_color0 = vec4(delta, 0.0);
+    if (max(max(abs(delta.x), abs(delta.y)), abs(delta.z)) < 1.0 / 4096.0) {
+        // Nothing to add (below a sixteenth of an 8-bit step, encoded): no blend, so no read and
+        // write of the 16-bit target for this pixel (the shadows, most of a frame).
+        discard;
+    }
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_display_copy.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_display_copy.frag
new file mode 100644
index 0000000..be4c5f7
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_display_copy.frag
@@ -0,0 +1,57 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Native+ (the 16-bit chain): replaces the game's display copy
+// (38d65b32), which copies its finished image into the display buffer through its brightness
+// curve (a 1D table per channel). The table covers 0..1; above the game's white the value goes on
+// as the table's value at white times the input (still in the chain's gamma encoding: the final
+// pass decodes it, hdr_output.frag native16_nits). The names are the recompiled shader's:
+// vk_hdr_channel.cpp copies its bindings and locations onto these.
+
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+// The recompiler's push constants (shader_recompiler/resource.h, PushData) at the C++ struct's
+// offsets (checked in vk_rasterizer.cpp).
+layout(push_constant, std430) uniform AuxData {
+    layout(offset = 0) float xoffset;
+    layout(offset = 4) float yoffset;
+    layout(offset = 8) float xscale;
+    layout(offset = 12) float yscale;
+    layout(offset = 80) uvec4 buf_offsets0;
+    layout(offset = 96) uvec4 buf_offsets1;
+    layout(offset = 112) uvec2 buf_offsets2;
+    layout(offset = 120) uint motion_param;
+    layout(offset = 124) uint scene_size;
+} push_data;
+
+layout(set = 0, binding = 0) uniform texture2D fs_img0;
+// The brightness table (one row per channel): a 1D array image. Lantern's recompiler keeps 1D
+// image types (shadPS4 0.20.1, bbport's, binds it as a 2D array view instead): a 2D array
+// declaration read 0 here and the whole frame was black.
+layout(set = 0, binding = 1) uniform texture1DArray fs_img1;
+layout(set = 0, binding = 2) uniform sampler fs_samp0;
+
+layout(location = 0) out vec4 frag_color0;
+
+float table(float v, float row) {
+    if (v <= 1.0) {
+        return texture(sampler1DArray(fs_img1, fs_samp0), vec2(v, row)).x;
+    }
+    return texture(sampler1DArray(fs_img1, fs_samp0), vec2(1.0, row)).x * v;
+}
+
+// Below 0 (PsychoV-30 with a BT.2020 target: a channel of a color outside BT.709), the curve
+// continued point-symmetric about its value at 0: the table alone read its value at 0 there and
+// the channel lost its sign.
+float brightness(float v, float row) {
+    return v >= 0.0 ? table(v, row) : 2.0 * table(0.0, row) - table(-v, row);
+}
+
+void main() {
+    uint w = push_data.scene_size & 65535u;
+    uint h = push_data.scene_size >> 16u;
+    vec2 scale = vec2(1920.0 / float(w == 0u ? 1920u : w), 1080.0 / float(h == 0u ? 1080u : h));
+    vec4 v = texelFetch(fs_img0, ivec2(floor(gl_FragCoord.xy * scale)), 0);
+    frag_color0 = vec4(brightness(v.z, 2.0), brightness(v.y, 1.0), brightness(v.x, 0.0), v.w);
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_glow_source.frag b/gpu/shadps4/video_core/host_shaders/hdr/bb_glow_source.frag
new file mode 100644
index 0000000..bfa8f65
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_glow_source.frag
@@ -0,0 +1,28 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Native+ (the 16-bit chain): replaces the game's EmissiveToGlowPS
+// (57f3b8c2), a copy of the finished image into the glow's source. The copy is clamped to the
+// game's white, so the glow (added back over the image after the tone mapping) stays as the
+// game draws it while the image itself carries HDR light. The names are the recompiled
+// shader's: vk_hdr_channel.cpp copies its bindings and locations onto these.
+
+#version 450
+#ifndef BB_HW_INTERP
+#extension GL_EXT_fragment_shader_barycentric : require
+#endif
+#extension GL_GOOGLE_include_directive : require
+
+#include "bb_inputs.glsl"
+
+layout(set = 0, binding = 0) uniform texture2D fs_img0;
+layout(set = 0, binding = 1) uniform sampler fs_samp0;
+
+BB_INPUT(0, fs_in_attr0);
+layout(location = 0) out vec4 frag_color0;
+
+void main() {
+    vec4 c = textureLod(sampler2D(fs_img0, fs_samp0), BB_UV(fs_in_attr0), 0.0);
+    // The game's channel order: its target holds them swapped.
+    frag_color0 = vec4(min(c.zyx, vec3(1.0)), c.w);
+}
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/bb_inputs.glsl b/gpu/shadps4/video_core/host_shaders/hdr/bb_inputs.glsl
new file mode 100644
index 0000000..9a3dce9
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/bb_inputs.glsl
@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: Copyright 2026 bbport
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// bbport Native+: how a replacement reads the game shader's inputs. Each replacement is built twice
+// (gpu/CMakeLists.txt); vk_hdr_channel.cpp picks one per game shader:
+//   - per vertex (the default): every input of the game's pixel shader is read per vertex and
+//     interpolated by GCN's own formula (the recompiler's manual interpolation on NVIDIA), so the
+//     replacement reads them so too and computes the game's values bit for bit;
+//   - BB_HW_INTERP: the GPU interpolates them (Lantern 0.9.37's hardware interpolation pass gave
+//     them back, or a GPU without fragment-shader barycentrics: AMD, Intel). The game's vertex
+//     shader outputs the same values at the same locations either way.
+// The includer puts, right after its #version line:
+//     #ifndef BB_HW_INTERP
+//     #extension GL_EXT_fragment_shader_barycentric : require
+//     #endif
+
+#ifndef BBPORT_BB_INPUTS_GLSL
+#define BBPORT_BB_INPUTS_GLSL
+
+#ifdef BB_HW_INTERP
+// An input as the GPU interpolates it: BB_UV(name) is its value's first two components.
+#define BB_INPUT(L, NAME) layout(location = L) in vec4 NAME
+#define BB_UV(NAME) (NAME).xy
+#else
+// An input read per vertex: BB_UV(name) interpolates it as GCN does (v_interp_p1/p2:
+// P0 + I (P1 - P0) + J (P2 - P0)), with the hardware's barycentrics.
+#define BB_INPUT(L, NAME) layout(location = L) pervertexEXT in vec4 NAME[3]
+#define BB_UV(NAME) bb_interp_uv(NAME[0], NAME[1], NAME[2])
+vec2 bb_interp_uv(vec4 a0, vec4 a1, vec4 a2) {
+    precise float dx1 = a1.x - a0.x;
+    precise float dx2 = a2.x - a0.x;
+    precise float dy1 = a1.y - a0.y;
+    precise float dy2 = a2.y - a0.y;
+    return vec2(fma(dx2, gl_BaryCoordEXT.z, fma(dx1, gl_BaryCoordEXT.y, a0.x)),
+                fma(dy2, gl_BaryCoordEXT.z, fma(dy1, gl_BaryCoordEXT.y, a0.y)));
+}
+#endif
+
+#endif // BBPORT_BB_INPUTS_GLSL
diff --git a/gpu/shadps4/video_core/host_shaders/hdr/gamut_bridge.glsl b/gpu/shadps4/video_core/host_shaders/hdr/gamut_bridge.glsl
new file mode 100644
index 0000000..734a8c2
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr/gamut_bridge.glsl
@@ -0,0 +1,194 @@
+// SPDX-FileCopyrightText: Copyright (C) 2026 Carlos Lopez (RenoDX), bbport
+// SPDX-License-Identifier: MIT
+//
+// bbport: GLSL port of RenoDX's AdaptiveD65 BT.709 gamut compression (https://github.com/
+// clshortfuse/renodx, src/shaders/color/gamut.hlsl and macleod_boynton.hlsl, MIT), the piece of
+// RenoDX's SDR LUT bridge (.agents/skills/handle-sdr-tonemap-lut/snippets/sdr_lut_bridge.hlsl)
+// that hdr/bb_color_grading.frag uses: colors outside BT.709 are
+// brought inside it along the line to white in MacLeod-Boynton chromaticity (CIE 170-2
+// weights, Stockman-Sharpe LMS relative to D65 white), then the same line taken back out after
+// the LUT. Strength 1, not compressing in-gamut colors, as the snippet calls them. The constants
+// are RenoDX's matrices multiplied out in double precision, checked against RenoDX's HLSL.
+
+#ifndef BBPORT_GAMUT_BRIDGE_GLSL
+#define BBPORT_GAMUT_BRIDGE_GLSL
+
+const vec3 BB_GM_BT709_TO_LMS[3] = vec3[3](  // rows
+    vec3(0.2896057766, 0.6972466442, 0.07637127862),
+    vec3(0.09018375762, 0.7073490257, 0.1122031464),
+    vec3(0.01552874012, 0.05360930731, 0.5097978305));
+const vec3 BB_GM_LMS_TO_BT709[3] = vec3[3](  // rows
+    vec3(4.96761965, -4.922379529, 0.3391991812),
+    vec3(-0.6196828788, 2.051750652, -0.3587439844),
+    vec3(-0.08615200402, -0.065819383, 1.988954483));
+const vec3 BB_GM_WEIGHTS = vec3(0.68990272, 0.34832189, 0.03715970692);
+const vec3 BB_GM_ADAPTIVE_LMS = vec3(1.063223699, 0.9097359297, 0.5789358779); // LMS of BT.709 (1, 1, 1)
+const vec2 BB_GM_WHITE = vec2(0.6983281224, 0.02047613467);                    // D65 in MB
+// The BT.709 primaries in adaptive-relative weighted MB.
+const vec2 BB_GM_BOUND_R = vec2(0.8447741838, 0.004480724501);
+const vec2 BB_GM_BOUND_G = vec2(0.6255404359, 0.004757598166);
+const vec2 BB_GM_BOUND_B = vec2(0.5356426431, 0.3536890971);
+
+const float BB_GM_EPSILON = 1e-20;
+const float BB_GM_NEAR_WHITE = 1e-14;
+const float BB_GM_RAY_T_MAX = 1e20;
+const float BB_GM_INTERVAL_MAX = 3.402823466e38;
+const vec2 BB_GM_CIE_NORMALS[7] = vec2[7](
+    vec2(-0.043889, -0.006807), vec2(-0.007821, -0.008564), vec2(-0.000604, -0.007942),
+    vec2(0.0, -0.080835), vec2(0.953597, 0.307020), vec2(-0.060969, 0.019752),
+    vec2(-0.106895, 0.004035));
+const float BB_GM_CIE_NUMERATORS[7] = float[7](
+    0.0065035249, 0.00104900495, 0.000207697044, 0.00165556648, 0.252472349, 0.0241967351,
+    0.0199621232);
+
+vec3 bb_gm_rows(const vec3 m[3], vec3 v) {
+    return vec3(dot(m[0], v), dot(m[1], v), dot(m[2], v));
+}
+
+// macleod_boynton::from::WeightedLMS: (l, s, l + m).
+vec3 bb_gm_mb(vec3 w) {
+    float y = max(w.x + w.y, 0.0);
+    float inv = y == 0.0 ? 0.0 : 1.0 / y;
+    return vec3(w.x * inv, w.z * inv, y);
+}
+
+vec3 bb_gm_weighted(vec2 ls, float y) {
+    return vec3(ls.x, 1.0 - ls.x, ls.y) * y;
+}
+
+// RayExitTCIE1702D: from white along `direction` to the CIE 170-2 locus (its 7 half-spaces).
+float bb_gm_ray_exit_cie(vec2 direction) {
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) {
+        return BB_GM_RAY_T_MAX;
+    }
+    float t_best = BB_GM_RAY_T_MAX;
+    bool hit_any = false;
+    for (int i = 0; i < 7; ++i) {
+        float denom = dot(BB_GM_CIE_NORMALS[i], direction);
+        float t = denom > 1e-8 ? BB_GM_CIE_NUMERATORS[i] / denom : BB_GM_RAY_T_MAX;
+        t_best = min(t_best, t);
+        hit_any = hit_any || denom > 1e-8;
+    }
+    return hit_any ? max(t_best, 0.0) : BB_GM_RAY_T_MAX;
+}
+
+float bb_gm_cross(vec2 a, vec2 b) {
+    return a.x * b.y - a.y * b.x;
+}
+
+bool bb_gm_segment_hit(vec2 origin, vec2 direction, vec2 a, vec2 b, out float t_hit) {
+    t_hit = 0.0;
+    vec2 edge = b - a;
+    float denom = bb_gm_cross(direction, edge);
+    if (abs(denom) <= BB_GM_EPSILON) return false;
+    vec2 a_origin = a - origin;
+    float t = bb_gm_cross(a_origin, edge) / denom;
+    float u = bb_gm_cross(a_origin, direction) / denom;
+    if (t < 0.0 || u < 0.0 || u > 1.0) return false;
+    t_hit = t;
+    return true;
+}
+
+// RayMaxT_RGBTriangleInMB: from white along `direction` to the BT.709 triangle.
+float bb_gm_ray_triangle(vec2 direction, out bool has_solution) {
+    has_solution = false;
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) return 0.0;
+    float t_best = BB_GM_INTERVAL_MAX, t_hit;
+    bool hit_any = false;
+    if (bb_gm_segment_hit(BB_GM_WHITE, direction, BB_GM_BOUND_R, BB_GM_BOUND_G, t_hit)) {
+        t_best = min(t_best, t_hit);
+        hit_any = true;
+    }
+    if (bb_gm_segment_hit(BB_GM_WHITE, direction, BB_GM_BOUND_G, BB_GM_BOUND_B, t_hit)) {
+        t_best = min(t_best, t_hit);
+        hit_any = true;
+    }
+    if (bb_gm_segment_hit(BB_GM_WHITE, direction, BB_GM_BOUND_B, BB_GM_BOUND_R, t_hit)) {
+        t_best = min(t_best, t_hit);
+        hit_any = true;
+    }
+    has_solution = hit_any;
+    return hit_any ? max(t_best, 0.0) : 0.0;
+}
+
+// ClampWeightedLMSToCIE1702 (purity 1).
+vec3 bb_gm_clamp_cie(vec3 w) {
+    vec3 c = max(w, 0.0);
+    vec3 mb = bb_gm_mb(c);
+    if (!(mb.z > BB_GM_EPSILON)) return vec3(c.x, c.y, 0.0);
+    vec2 direction = mb.xy - BB_GM_WHITE;
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) return c;
+    float t_final = min(1.0, bb_gm_ray_exit_cie(direction));
+    return bb_gm_weighted(BB_GM_WHITE + direction * t_final, mb.z);
+}
+
+// The adaptive-relative weighted LMS of a BT.709 color, and back.
+vec3 bb_gm_relative(vec3 bt709) {
+    vec3 w = BB_GM_WEIGHTS * bb_gm_rows(BB_GM_BT709_TO_LMS, bt709);
+    return vec3(BB_GM_ADAPTIVE_LMS.x == 0.0 ? 0.0 : w.x / BB_GM_ADAPTIVE_LMS.x,
+                BB_GM_ADAPTIVE_LMS.y == 0.0 ? 0.0 : w.y / BB_GM_ADAPTIVE_LMS.y,
+                BB_GM_ADAPTIVE_LMS.z == 0.0 ? 0.0 : w.z / BB_GM_ADAPTIVE_LMS.z);
+}
+
+vec3 bb_gm_bt709(vec3 relative) {
+    return bb_gm_rows(BB_GM_LMS_TO_BT709,
+                      relative * max(BB_GM_ADAPTIVE_LMS, vec3(1e-6)) / BB_GM_WEIGHTS);
+}
+
+// ComputeGamutCompressionScaleBT709AdaptiveD65(color, D65, strength 1): 1 inside BT.709, the
+// share of the line to white kept outside it.
+float bb_gamut_compression_scale(vec3 bt709) {
+    vec3 c = bb_gm_clamp_cie(max(bb_gm_relative(bt709), 0.0));
+    vec3 mb = bb_gm_mb(c);
+    if (!(mb.z > BB_GM_EPSILON)) return 1.0;
+    vec2 direction = mb.xy - BB_GM_WHITE;
+    if (dot(direction, direction) <= BB_GM_NEAR_WHITE) return 1.0;
+    bool has_peak;
+    float t_peak = bb_gm_ray_triangle(direction, has_peak);
+    float t_clip = bb_gm_ray_exit_cie(direction);
+    if (!has_peak) t_peak = t_clip;
+    float t_hard = clamp(t_peak, 0.0, 1.0);
+    // NeutwoScaleFromRayT(min(t_peak, t_clip), t_clip): Neutwo(1, peak, clip).
+    float peak = max(min(t_peak, t_clip), 0.0);
+    float clip = max(t_clip, peak);
+    float neutwo = clip * peak * inversesqrt(max((clip * clip - peak * peak) + clip * clip * peak * peak, 1e-20));
+    float t_soft = clamp(neutwo, 0.0, 1.0);
+    // SoftCompressionActivationFromRayT(t_peak, 0.08).
+    float outside = 1.0 - clamp(t_peak, 0.0, 1.0);
+    float soft_mix = outside / (outside + 0.08);
+    return mix(t_hard, t_soft, soft_mix);
+}
+
+// GamutCompressBT709AdaptiveD65.
+vec3 bb_gamut_compress(vec3 bt709, float scale) {
+    vec3 c = bb_gm_clamp_cie(max(bb_gm_relative(bt709), 0.0));
+    vec3 mb = bb_gm_mb(c);
+    vec3 out_rel;
+    if (!(mb.z > BB_GM_EPSILON)) {
+        out_rel = vec3(c.x, c.y, 0.0);
+    } else {
+        vec2 direction = mb.xy - BB_GM_WHITE;
+        out_rel = dot(direction, direction) <= BB_GM_NEAR_WHITE
+                      ? c
+                      : bb_gm_weighted(BB_GM_WHITE + clamp(scale, 0.0, 1.0) * direction, mb.z);
+    }
+    return bb_gm_bt709(out_rel);
+}
+
+// GamutDecompressBT709AdaptiveD65.
+vec3 bb_gamut_decompress(vec3 bt709, float scale) {
+    vec3 c = max(bb_gm_relative(bt709), 0.0);
+    vec3 mb = bb_gm_mb(c);
+    vec3 out_rel;
+    if (!(mb.z > BB_GM_EPSILON)) {
+        out_rel = vec3(c.x, c.y, 0.0);
+    } else {
+        vec2 direction = mb.xy - BB_GM_WHITE;
+        out_rel = dot(direction, direction) <= BB_GM_NEAR_WHITE
+                      ? c
+                      : bb_gm_weighted(BB_GM_WHITE + direction / max(scale, 1e-6), mb.z);
+    }
+    return bb_gm_bt709(out_rel);
+}
+
+#endif
